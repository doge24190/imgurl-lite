{
  "openapi": "3.0.3",
  "info": {
    "title": "ImgURL Lite Management API",
    "version": "1.1.0",
    "description": "Scoped, expiring, revocable Bearer credentials. Create and revoke tokens only in the CSRF-protected admin UI. Per-minute limits: 300/IP and 120/token. Responses are JSON with Cache-Control: no-store. Production clients must use HTTPS."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Check readiness; detailed checks require health:read",
        "security": [
          {},
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Ready",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "data"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "$ref": "#/components/schemas/Health"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "405": {
            "$ref": "#/components/responses/405"
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        }
      }
    },
    "/api/v1/images": {
      "get": {
        "operationId": "listImages",
        "summary": "List non-adult images, including admin uploads",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-required-scopes": [
          "images:read"
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "1-based page number",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000,
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "description": "Items per page",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 24
            }
          },
          {
            "name": "search",
            "in": "query",
            "description": "Case-sensitive substring in filename or image ID; maximum 200 UTF-8 bytes",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "usage",
            "in": "query",
            "description": "Include suitability and reason for the selected role",
            "schema": {
              "type": "string",
              "enum": [
                "background",
                "logo",
                "favicon"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Images",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "data"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "items",
                        "page",
                        "per_page",
                        "has_more"
                      ],
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Image"
                          }
                        },
                        "page": {
                          "type": "integer"
                        },
                        "per_page": {
                          "type": "integer"
                        },
                        "has_more": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "405": {
            "$ref": "#/components/responses/405"
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        }
      },
      "post": {
        "operationId": "uploadImage",
        "summary": "Upload one raster image",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-required-scopes": [
          "images:upload"
        ],
        "description": "Uploads count as admin uploads and respect site byte/pixel limits and PHP limits. Accepts real PNG, JPEG, GIF, BMP and WebP. Shares validation, locking, deduplication and transactional persistence with legacy uploads. Duplicate files return 200 and duplicate=true, without exposing existing filenames or public deletion keys. Restricted duplicates return 409. Existing tokens are not automatically granted this scope.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Image created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "data"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "$ref": "#/components/schemas/UploadedImage"
                    }
                  }
                }
              }
            },
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                },
                "description": "Relative image resource endpoint /api/v1/images/{imgid}"
              }
            }
          },
          "200": {
            "description": "Identical image already exists",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "data"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "$ref": "#/components/schemas/UploadedImage"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "405": {
            "$ref": "#/components/responses/405"
          },
          "409": {
            "$ref": "#/components/responses/409"
          },
          "413": {
            "$ref": "#/components/responses/413"
          },
          "415": {
            "$ref": "#/components/responses/415"
          },
          "422": {
            "$ref": "#/components/responses/422"
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        }
      }
    },
    "/api/v1/images/{imgid}": {
      "get": {
        "operationId": "getImage",
        "summary": "Get one non-adult image",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-required-scopes": [
          "images:read"
        ],
        "parameters": [
          {
            "name": "imgid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{16}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Image",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "data"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "$ref": "#/components/schemas/Image"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "405": {
            "$ref": "#/components/responses/405"
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        }
      },
      "delete": {
        "operationId": "deleteImage",
        "summary": "Permanently delete one image and its thumbnail",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-required-scopes": [
          "images:delete"
        ],
        "description": "This separate permission allows deletion of any registered image, including visitor/admin uploads and adult-marked images. Uses only the URL imgid and database paths, with the shared image lock, staged file deletion and database rollback. Preserves independent site branding snapshots. Already absent images return 404. Existing tokens are not automatically granted this scope.",
        "parameters": [
          {
            "name": "imgid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{16}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Image deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "data"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "imgid",
                        "deleted"
                      ],
                      "properties": {
                        "imgid": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{16}$"
                        },
                        "deleted": {
                          "type": "boolean",
                          "enum": [
                            true
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "405": {
            "$ref": "#/components/responses/405"
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        }
      }
    },
    "/api/v1/settings/appearance": {
      "get": {
        "operationId": "getAppearance",
        "summary": "Read current appearance and image requirements",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-required-scopes": [
          "appearance:read"
        ],
        "responses": {
          "200": {
            "description": "Appearance",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "data"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "$ref": "#/components/schemas/Appearance"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "405": {
            "$ref": "#/components/responses/405"
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        }
      },
      "patch": {
        "operationId": "updateAppearance",
        "summary": "Atomically select uploaded images or restore defaults",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-required-scopes": [
          "appearance:write"
        ],
        "description": "Uses the same validation, locking, snapshot and rollback service as the admin form. Omitted fields and unrelated site settings are preserved. URLs and file paths are not accepted.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": false,
                "properties": {
                  "background": {
                    "type": "string",
                    "pattern": "^(?:[a-fA-F0-9]{16}|default)$"
                  },
                  "logo": {
                    "type": "string",
                    "pattern": "^(?:[a-fA-F0-9]{16}|default)$"
                  },
                  "favicon": {
                    "type": "string",
                    "pattern": "^(?:[a-fA-F0-9]{16}|default)$"
                  }
                }
              },
              "example": {
                "background": "0123456789abcdef",
                "favicon": "default"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated appearance",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "data"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "$ref": "#/components/schemas/Appearance"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "405": {
            "$ref": "#/components/responses/405"
          },
          "413": {
            "$ref": "#/components/responses/413"
          },
          "415": {
            "$ref": "#/components/responses/415"
          },
          "422": {
            "$ref": "#/components/responses/422"
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque",
        "description": "Use an imgurl_ token from System settings → API tokens. Never put the token in URLs or cookies."
      }
    },
    "schemas": {
      "Image": {
        "type": "object",
        "required": [
          "imgid",
          "name",
          "created_at",
          "available",
          "url",
          "thumbnail_url",
          "width",
          "height",
          "mime",
          "size_bytes"
        ],
        "properties": {
          "imgid": {
            "type": "string",
            "pattern": "^[a-f0-9]{16}$"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "description": "Original upload timestamp in the server timezone"
          },
          "available": {
            "type": "boolean"
          },
          "url": {
            "type": "string",
            "nullable": true,
            "description": "Path relative to the site root; null when unavailable"
          },
          "thumbnail_url": {
            "type": "string",
            "nullable": true,
            "description": "Path relative to the site root; null when unavailable"
          },
          "width": {
            "type": "integer",
            "nullable": true
          },
          "height": {
            "type": "integer",
            "nullable": true
          },
          "mime": {
            "type": "string",
            "nullable": true
          },
          "size_bytes": {
            "type": "integer",
            "nullable": true
          },
          "eligible": {
            "type": "boolean",
            "description": "Only included when usage is specified; full decode is validated at save time"
          },
          "reason": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Appearance": {
        "type": "object",
        "required": [
          "background",
          "logo",
          "favicon",
          "requirements"
        ],
        "properties": {
          "background": {
            "type": "string",
            "nullable": true,
            "description": "Path relative to the site root; null when unavailable"
          },
          "logo": {
            "type": "string"
          },
          "favicon": {
            "type": "string"
          },
          "requirements": {
            "type": "object",
            "description": "Supported formats, file and pixel limits, and dimensions for each role",
            "additionalProperties": true
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "api_version"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "api_version": {
            "type": "string",
            "enum": [
              "v1"
            ]
          },
          "application_version": {
            "type": "string",
            "description": "Only with health:read"
          },
          "checks": {
            "type": "object",
            "description": "Only with health:read",
            "properties": {
              "installed": {
                "type": "boolean"
              },
              "database": {
                "type": "boolean"
              },
              "storage": {
                "type": "boolean"
              },
              "image_processing": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "ok",
          "error"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          },
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "UploadedImage": {
        "type": "object",
        "required": [
          "imgid",
          "url",
          "thumbnail_url",
          "width",
          "height",
          "mime",
          "size_bytes",
          "duplicate",
          "delete_endpoint"
        ],
        "properties": {
          "imgid": {
            "type": "string",
            "pattern": "^[a-f0-9]{16}$"
          },
          "url": {
            "type": "string",
            "description": "Image URL using the configured storage domain"
          },
          "thumbnail_url": {
            "type": "string",
            "description": "Thumbnail URL, or the original URL for a small image"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "mime": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "duplicate": {
            "type": "boolean"
          },
          "delete_endpoint": {
            "type": "string",
            "description": "Use DELETE with a token carrying images:delete; this URL is not a deletion credential"
          }
        }
      }
    },
    "responses": {
      "400": {
        "description": "Invalid parameter or malformed JSON",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "401": {
        "description": "Missing, expired, revoked or invalid Bearer token",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "headers": {
          "WWW-Authenticate": {
            "schema": {
              "type": "string"
            },
            "description": "Bearer authentication challenge"
          }
        }
      },
      "403": {
        "description": "Insufficient token scope",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "404": {
        "description": "Image or endpoint not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "405": {
        "description": "Method not allowed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "headers": {
          "Allow": {
            "schema": {
              "type": "string"
            },
            "description": "Allowed HTTP methods"
          }
        }
      },
      "413": {
        "description": "Image or multipart request exceeds site/PHP limits, or appearance JSON body exceeds 16 KB",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "415": {
        "description": "Expected multipart/form-data for image upload, or application/json for appearance PATCH",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "422": {
        "description": "Invalid image format, content or pixel count, or unsuitable appearance image",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "429": {
        "description": "Rate limited",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "headers": {
          "Retry-After": {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            },
            "description": "Seconds to wait before retrying"
          }
        }
      },
      "503": {
        "description": "Service or storage unavailable",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "409": {
        "description": "Image identifier conflict, or restricted duplicate image",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
